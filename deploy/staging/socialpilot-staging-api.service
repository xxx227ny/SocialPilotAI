[Unit]
Description=SocialPilot product staging web and API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=socialpilot
Group=socialpilot
WorkingDirectory=/opt/socialpilot-staging/current
Environment=PYTHONPATH=/opt/socialpilot-staging/current/backend
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1
Environment=SOCIALPILOT_SERVER_CONFIG=/etc/socialpilot-staging/runtime.json
ExecStart=/opt/socialpilot-staging/venv/bin/python -m uvicorn server_app:app --host 127.0.0.1 --port 8081 --workers 1 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/socialpilot-staging
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryHigh=600M
MemoryMax=900M
TasksMax=192

[Install]
WantedBy=multi-user.target
