[Unit]
Description=SocialPilot product staging execution worker
After=network-online.target socialpilot-staging-api.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=socialpilot
Group=socialpilot
WorkingDirectory=/opt/socialpilot-staging/current
Environment=PYTHONPATH=/opt/socialpilot-staging/current/backend
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1
Environment=SOCIALPILOT_SERVER_CONFIG=/etc/socialpilot-staging/runtime.json
ExecStart=/opt/socialpilot-staging/venv/bin/python server_worker.py --database /var/lib/socialpilot-staging/socialpilot.db --status-file /var/lib/socialpilot-staging/worker-status.json --stop-file /var/lib/socialpilot-staging/worker.stop --instance-id socialpilot-product-staging --poll-seconds 2
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/socialpilot-staging
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryHigh=900M
MemoryMax=1200M
TasksMax=192
Nice=10
CPUWeight=20
CPUQuota=100%
IOWeight=20

[Install]
WantedBy=multi-user.target
