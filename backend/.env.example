APP_NAME=socialpilot-api
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEBUG=false
DATABASE_URL=sqlite:///./socialpilot.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_USER_AUTH=false
ALLOW_PUBLIC_REGISTRATION=false
USER_AUTH_SESSION_TTL_SECONDS=604800
USER_AUTH_COOKIE_SECURE=false
USER_AUTH_LOGIN_MAX_FAILURES=5
USER_AUTH_LOGIN_WINDOW_SECONDS=900
USER_AUTH_LOGIN_LOCK_SECONDS=900
ACCOUNT_PUBLIC_WEB_ORIGIN=
ACCOUNT_EMAIL_FROM=
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_USERNAME=
ACCOUNT_SMTP_PASSWORD=
ACCOUNT_SMTP_SECURITY=starttls
ACCOUNT_SMTP_TIMEOUT_SECONDS=15
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
ACCOUNT_EMAIL_REQUEST_COOLDOWN_SECONDS=60
USER_CREDENTIAL_ENCRYPTION_KEY=
USER_CREDENTIAL_ENCRYPTION_KEY_ID=v1
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_ENDPOINT=
QWEN_TIMEOUT=30
REQUIRE_LIVE_PROVIDER_COHERENCE=false
WANX_API_KEY=
WANX_MODEL=wan2.7-t2v
WANX_REGION=cn-beijing
WANX_WORKSPACE_ID=
WANX_ENDPOINT=
WANX_TIMEOUT=30
VIDEO_ARTIFACT_STORAGE_ROOT=
VIDEO_ARTIFACT_MAX_BYTES=50000000
ENABLE_VIDEO_PREVIEW_PREWARM=false
ENABLE_COPY_EXECUTION=false
ENABLE_V2_COPY_EXECUTION=false
ENABLE_V2_VIDEO_PROJECT_EXECUTION=false
ENABLE_VIDEO_RENDER_EXECUTION=false
ENABLE_GROWTH_EXECUTION=false
